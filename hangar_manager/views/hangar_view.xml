<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hangar_form" model="ir.ui.view">
        <field name="name">hangar.form</field>
        <field name="model">hangar.manager.hangar</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="status"/>
                        <field name="slots_available"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="hangar_tree" model="ir.ui.view">
        <field name="name">hangar.tree</field>
        <field name="model">hangar.manager.hangar</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
                <field name="status"/>
                <field name="slots_available"/>
            </tree>
        </field>
    </record>

    <record id="action_hangar" model="ir.actions.act_window">
        <field name="name">Hangar</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hangar.manager.hangar</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_child':1}</field>
    </record>

    <menuitem id="menu_hangar"
              name="Hangars"
              parent="menu_hangar_root"
              action="action_hangar"
              sequence="10"/>
</odoo>